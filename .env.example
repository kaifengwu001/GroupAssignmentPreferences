# Copy to .env.local for development. On Vercel, set these under
# Settings -> Environment Variables.

# --- Required in production -------------------------------------------------

# Postgres connection string. Easiest path: Vercel dashboard -> Storage ->
# Neon, which sets DATABASE_URL for you. Any Postgres 13+ works.
# Leave blank locally to use the in-memory dev store (data is lost on restart).
DATABASE_URL=

# TLS is inferred from the host: required for remote, off for localhost.
# Set to "require" or "disable" only if that guess is wrong.
DATABASE_SSL=

# Signs session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Password for the /admin dashboard (lock switch + CSV downloads).
ADMIN_PASSWORD=

# --- Deadlines --------------------------------------------------------------

# When pitching and selection close. Reaching this locks the app on its own,
# with no action needed. The admin switch can still close early or reopen
# afterwards. ISO 8601 with an offset.
CLOSES_AT=2026-09-17T23:59:00-07:00

# When groups are announced. Display only; nothing happens at this time.
RESULTS_AT=2026-09-18T14:00:00-07:00

# Timezone every date is rendered in, so all students see the same deadline
# regardless of their device.
DISPLAY_TIMEZONE=America/Los_Angeles

# --- Optional ---------------------------------------------------------------

# Heading shown across the app.
SECTION_TITLE=SECTION PITCH

# Restrict sign-in to these names, per section. A name may only sign in to the
# section it is listed under; choosing the other one is rejected with a message
# naming the right section, so nobody loses their rankings to a misclick.
#
# One name per line ("Last, First" is fine — the separator is the newline, not
# the comma, precisely so that roster exports paste in unchanged). Matching
# ignores case, accents, punctuation, spacing, and the order of name parts, so
# "Okonjo Blake, Marcus" also answers to "marcus okonjo blake".
#
# The number of names here is also the "pitches in" denominator students see,
# replacing the fallback headcount in lib/sections.ts.
#
# Leave blank to let anyone sign in under any name.
#
# Keep real names here and never in the repo: this project is public, and a
# class roster is not something to publish. Multi-line values are supported by
# Vercel's environment variable editor.
SECTION_ROSTER_2PM=
SECTION_ROSTER_3PM=

# When a name has no password yet, the first password supplied claims it.
# Set to false to disable password protection entirely.
ALLOW_PASSWORD_CLAIM=true
